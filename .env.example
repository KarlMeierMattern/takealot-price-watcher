# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Sender must use a verified domain in Resend (or onboarding@resend.dev for testing)
EMAIL_FROM=Price Watcher <onboarding@resend.dev>
EMAIL_TO=you@example.com

# Optional: also alert when price falls at or below this amount (ZAR, no "R" prefix)
# TARGET_PRICE=7500

# Optional: direct Geewiz product URL if search cannot find the listing
# GEEWIZ_PRODUCT_URL=https://www.geewiz.co.za/new-items/123456-example.html
